+static bool
+IsApplicationUdpRouteDrop(const Ipv4Header& ipHeader,
+                           Ptr<const Packet> packet,
+                           Ipv4L3Protocol::DropReason reason)
+{
+    // Ipv4L3Protocol's Drop trace supplies the IPv4 payload, not a serialized
+    // IPv4 packet. Fragment-timeout callbacks may supply only a partial payload.
+    // Only no-route and route-error counters need application-port attribution.
+    if ((reason != Ipv4L3Protocol::DROP_NO_ROUTE &&
+         reason != Ipv4L3Protocol::DROP_ROUTE_ERROR) ||
+        ipHeader.GetProtocol() != 17 || !packet)
+    {
+        return false;
+    }
+
+    UdpHeader udp;
+    if (packet->GetSize() < udp.GetSerializedSize())
+    {
+        return false;
+    }
+    return packet->PeekHeader(udp) != 0 && udp.GetDestinationPort() == APP_PORT;
+}
